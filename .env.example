# Copy to .env and adjust. Never commit the real .env.

POSTGRES_USER=syria_maps
POSTGRES_PASSWORD=change-me
POSTGRES_DB=syria_maps

API_PORT=8000
# Public HTTPS URL of the API. It is written into the OsmAnd tile templates and the .osf package.
SYRIA_MAPS_PUBLIC_BASE_URL=http://localhost:8000
SYRIA_MAPS_CORS_ORIGINS=*
SYRIA_MAPS_CACHE_TTL_SECONDS=300

# true  = import database/fixtures/*.geojson (SYNTHETIC development data)
# false = migrations + layer sync only (production)
LOAD_SYNTHETIC_FIXTURES=true
